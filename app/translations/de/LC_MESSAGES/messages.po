#: app/templates/main/about.html:7
#, python-format
msgid ""
"%(name)s is an open-source, self-hostable tool for sharing secrets one-"
"time and securely. Messages are encrypted in your browser before they "
"leave your device — the server cannot read them, and neither can the "
"operator."
msgstr ""

#: app/templates/main/about.html:9
msgid "How it works"
msgstr ""

#: app/templates/main/about.html:11
msgid ""
"Your browser generates a random 256-bit key and encrypts the message with"
" AES-256-GCM."
msgstr ""

#: app/templates/main/about.html:12
msgid ""
"The ciphertext is uploaded; the key stays in the URL fragment (the part "
"after #), which is never sent to the server."
msgstr ""

#: app/templates/main/about.html:13
msgid ""
"Recipients decrypt the message in their browser. Once the configured "
"limits are reached, the ciphertext is deleted."
msgstr ""

#: app/templates/main/about.html:16
msgid "What we never see"
msgstr ""

#: app/templates/main/about.html:18
msgid "Your message content"
