#: app/templates/legal/security.html:4
#, python-format
msgid ""
"Security policy and threat model for %(name)s — encryption model, account"
" hardening, and how to report vulnerabilities."
msgstr ""
"Policy di sicurezza e threat model di %(name)s — modello di crittografia,"
