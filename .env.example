# =============================================================================
# OpenKeepr — environment variables
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.
#
# Convention: comments live on their own lines (never inline after KEY=VALUE)
# so empty values stay empty, regardless of how your dotenv parser handles
# inline `#` comments.
# =============================================================================

# --- Branding ---------------------------------------------------------------

# Shown in the navbar, page titles, footer and outbound e-mails.
APP_NAME=OpenKeepr

# Link to your source repository. Leave empty to hide the GitHub link.
GITHUB_URL=

# Optional "Buy Me a Coffee" link in the footer.
# Accepts either a full URL or just your username.
# Leave empty to hide the link.
BUYMEACOFFEE_URL=

# --- Runtime ----------------------------------------------------------------

# development | production
FLASK_ENV=development

# true in dev, false in prod
DEBUG=true

# Bind address and port (used by `python run.py`, the dev server)
HOST=127.0.0.1
PORT=5000

# Canonical public URL — used to build share links
BASE_URL=http://127.0.0.1:5000

# Display timezone (IANA name). Database timestamps are always stored in UTC;
# this only affects how dates are *rendered* in the UI and in e-mails.
TIMEZONE=Europe/Amsterdam

# Gunicorn bind address (production WSGI). When commented out, the default
# from deploy/gunicorn.conf.py is used (Unix socket /run/openkeepr/openkeepr.sock).
# Uncomment and set if you'd rather bind to a TCP port directly:
#GUNICORN_BIND=0.0.0.0:5000
#GUNICORN_WORKERS=4
#GUNICORN_THREADS=4
#GUNICORN_TIMEOUT=30
#GUNICORN_LOG_LEVEL=info

# --- Secrets ---
# All three are REQUIRED. Generate each with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-please-generate-a-real-key
# Used to HMAC recipient e-mail addresses so we never store plaintext addresses
RECIPIENT_HASH_SECRET=changeme-please-generate-a-real-key
# Used to encrypt the small server-side metadata blob at rest
SERVER_ENCRYPTION_KEY=changeme-please-generate-a-real-key

# --- Database ---------------------------------------------------------------

# Default: SQLite in instance/openkeepr.db
DATABASE_URL=sqlite:///openkeepr.db

# --- Security ---------------------------------------------------------------

# true in prod (HTTPS only)
SESSION_COOKIE_SECURE=false
# https in prod
PREFERRED_URL_SCHEME=http
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated IPs/CIDRs of trusted reverse proxies. Leave empty if none.
TRUSTED_PROXIES=

# --- Message limits ---------------------------------------------------------

# Hard cap on ciphertext size (per message)
MAX_MESSAGE_SIZE_KB=256
# Hard cap on retention regardless of user input
MAX_RETENTION_DAYS=30
DEFAULT_EXPIRY_HOURS=24
MAX_OPENS_LIMIT=100
VERIFICATION_CODE_TTL_MINUTES=10

# --- Attachments ------------------------------------------------------------

# Set to false to disable attachments entirely (UI hidden, endpoints 404).
ATTACHMENTS_ENABLED=true
# Maximum size per file, in megabytes
ATTACHMENTS_MAX_FILE_SIZE_MB=25
# Maximum number of attachments per message
ATTACHMENTS_MAX_PER_MESSAGE=10
# Maximum combined size of all attachments per message, in megabytes
ATTACHMENTS_MAX_TOTAL_MB=100
# Comma-separated list of allowed file extensions (with leading dot) and/or
# MIME globs (e.g. "image/*"). Empty value means allow everything (not
# recommended). The server cannot inspect file contents (zero-knowledge),
# so this list is enforced in the browser — a user with the API can bypass
# it for their own uploads; it's primarily a UX hint and accident-prevention.
ATTACHMENTS_ALLOWED_TYPES=.pdf,.txt,.md,.csv,.log,.doc,.docx,.odt,.xls,.xlsx,.ods,.ppt,.pptx,.odp,.zip,.7z,.rar,.tar,.gz,image/*,.json,.xml,.yaml,.yml

# --- Email (OPTIONAL — disabled by default) ---------------------------------

# Set MAIL_ENABLED=true to allow OpenKeepr to send verification codes by e-mail.
# When false (default), recipients must receive their 6-digit code via the
# sender's own channel (chat, phone, etc.).
MAIL_ENABLED=false
# smtp | postmark | sendgrid | mailgun
MAIL_BACKEND=smtp
MAIL_FROM=OpenKeepr <noreply@example.com>

# SMTP-only settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Provider API keys (only the one matching MAIL_BACKEND is read)
POSTMARK_API_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Admin bootstrap --------------------------------------------------------

# On first start, if no admin exists, this account is created.
# You MUST enable 2FA after first login.
ADMIN_EMAIL=admin@example.com
# Leave empty to auto-generate (printed once in logs)
ADMIN_INITIAL_PASSWORD=

# When the admin disables public login from /admin/settings, this URL still
# works for admins (and anyone who knows it). Pick something hard to guess.
# Default: /admin-login. Examples: /backend-auth, /__staff_login.
ADMIN_LOGIN_PATH=/admin-login

# --- Rate limiting ----------------------------------------------------------

# Use redis://... in production
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per hour

# --- security.txt -----------------------------------------------------------

SECURITY_CONTACT=mailto:security@example.com
# Leave empty to default to ${BASE_URL}/security
SECURITY_POLICY_URL=
# security.txt expires field — auto-renewed each request
SECURITY_EXPIRES_DAYS=365

# --- i18n -------------------------------------------------------------------

DEFAULT_LANGUAGE=en
AVAILABLE_LANGUAGES=en,nl,fr,de,es,it
# Compile .po → .mo on startup if stale
AUTO_COMPILE_TRANSLATIONS=true

# --- Logging ----------------------------------------------------------------

LOG_LEVEL=INFO
# Leave empty to log to stdout (recommended; let systemd/journald capture it)
LOG_FILE=

# --- Feature flags ----------------------------------------------------------

# Allow public sign-up for new accounts
FEATURE_REGISTRATION=true
# Expose /api/v1
FEATURE_API=true
# Show in-app feedback form
FEATURE_FEEDBACK=true
# Only enable if you add non-essential cookies
FEATURE_COOKIE_BANNER=false
